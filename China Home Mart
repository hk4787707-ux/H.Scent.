<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>China Home Mart | Home & Kitchen Products</title>

<meta name="description" content="China Home Mart - Kitchen, Home Decor, Home Gadgets and useful products.">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#f7f7f7;
    color:#222;
}

/* TOP BAR */
.top-bar{
    background:#111;
    color:white;
    text-align:center;
    padding:9px;
    font-size:13px;
}

/* HEADER */
header{
    background:white;
    padding:18px 5%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    border-bottom:1px solid #ddd;
}

.logo-text{
    font-size:25px;
    font-weight:bold;
    color:#d71920;
    white-space:nowrap;
}

.search-box{
    flex:1;
    max-width:550px;
    display:flex;
}

.search-box input{
    width:100%;
    padding:13px 18px;
    border:1px solid #ccc;
    border-radius:6px 0 0 6px;
    font-size:15px;
    outline:none;
}

.search-box button{
    border:none;
    background:#d71920;
    color:white;
    padding:0 22px;
    border-radius:0 6px 6px 0;
    cursor:pointer;
    font-size:18px;
}

.header-icons{
    display:flex;
    gap:20px;
    font-size:14px;
    font-weight:bold;
}

.header-icons span{
    cursor:pointer;
}

/* NAV */
nav{
    background:#d71920;
    padding:14px 5%;
    display:flex;
    justify-content:center;
    gap:35px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
    font-size:14px;
}

/* HERO */
.hero{
    min-height:390px;
    background:linear-gradient(120deg,#111,#444);
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:white;
    padding:50px 20px;
}

.hero-content{
    max-width:750px;
}

.hero h1{
    font-size:48px;
    margin-bottom:15px;
}

.hero h1 span{
    color:#ffcc00;
}

.hero p{
    font-size:18px;
    margin-bottom:25px;
}

.hero-btn{
    display:inline-block;
    background:#d71920;
    color:white;
    padding:14px 30px;
    border-radius:5px;
    text-decoration:none;
    font-weight:bold;
}

/* SECTION */
.section{
    max-width:1200px;
    margin:auto;
    padding:55px 20px;
}

.section-title{
    text-align:center;
    font-size:30px;
    margin-bottom:35px;
}

.section-title span{
    color:#d71920;
}

/* CATEGORIES */
.categories{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.category{
    background:white;
    border:1px solid #ddd;
    border-radius:10px;
    padding:30px 15px;
    text-align:center;
    transition:.3s;
    cursor:pointer;
}

.category:hover{
    transform:translateY(-5px);
    box-shadow:0 8px 20px rgba(0,0,0,.12);
}

.category-icon{
    font-size:42px;
    margin-bottom:15px;
}

.category h3{
    font-size:17px;
}

/* PRODUCTS */
.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.product{
    background:white;
    border-radius:10px;
    overflow:hidden;
    border:1px solid #ddd;
    transition:.3s;
}

.product:hover{
    transform:translateY(-5px);
    box-shadow:0 8px 25px rgba(0,0,0,.12);
}

.product-image{
    height:230px;
    background:#eee;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:55px;
}

.product-info{
    padding:18px;
}

.product-info h3{
    font-size:17px;
    margin-bottom:10px;
}

.price{
    color:#d71920;
    font-size:20px;
    font-weight:bold;
    margin-bottom:15px;
}

.old-price{
    color:#999;
    text-decoration:line-through;
    font-size:14px;
    margin-left:7px;
}

.add-btn{
    width:100%;
    padding:11px;
    border:none;
    background:#111;
    color:white;
    border-radius:5px;
    cursor:pointer;
    font-weight:bold;
}

.add-btn:hover{
    background:#d71920;
}

/* FEATURES */
.features{
    background:white;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
    padding:35px 5%;
    border-top:1px solid #ddd;
    border-bottom:1px solid #ddd;
}

.feature{
    text-align:center;
}

.feature-icon{
    font-size:30px;
    margin-bottom:8px;
}

.feature strong{
    display:block;
    margin-bottom:5px;
}

/* NEWSLETTER */
.newsletter{
    background:#111;
    color:white;
    text-align:center;
    padding:55px 20px;
}

.newsletter h2{
    margin-bottom:10px;
}

.newsletter p{
    color:#ccc;
    margin-bottom:20px;
}

.newsletter input{
    width:300px;
    max-width:80%;
    padding:13px;
    border:none;
    border-radius:5px;
}

.newsletter button{
    padding:13px 22px;
    border:none;
    background:#d71920;
    color:white;
    border-radius:5px;
    font-weight:bold;
}

/* FOOTER */
footer{
    background:#050505;
    color:#aaa;
    text-align:center;
    padding:35px 20px;
}

footer h2{
    color:white;
    margin-bottom:10px;
}

footer p{
    font-size:13px;
}

/* MOBILE */
@media(max-width:800px){

    header{
        flex-wrap:wrap;
        justify-content:center;
    }

    .logo-text{
        width:100%;
        text-align:center;
    }

    .search-box{
        width:100%;
    }

    .header-icons{
        width:100%;
        justify-content:center;
    }

    nav{
        gap:15px;
        overflow-x:auto;
        justify-content:flex-start;
    }

    nav a{
        white-space:nowrap;
    }

    .hero h1{
        font-size:34px;
    }

    .categories{
        grid-template-columns:repeat(2,1fr);
    }

    .products{
        grid-template-columns:repeat(2,1fr);
    }

    .features{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:500px){

    .categories{
        grid-template-columns:repeat(2,1fr);
        gap:10px;
    }

    .category{
        padding:20px 8px;
    }

    .category-icon{
        font-size:32px;
    }

    .products{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .product-image{
        height:160px;
    }

    .product-info{
        padding:12px;
    }

    .product-info h3{
        font-size:14px;
    }

    .price{
        font-size:17px;
    }

    .features{
        grid-template-columns:1fr 1fr;
        padding:25px 15px;
    }
}
</style>
</head>

